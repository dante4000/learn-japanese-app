<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dante.translate</string>

  <!-- Runs as root only to bind port 80. The translator's `claude` child is
       dropped back to uid 501 (danielko) by runClaude, so it uses the real
       user's login and never writes root-owned files into ~/.claude. -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/danielko/dev/sites/apps/translate/node_modules/next/dist/bin/next</string>
    <string>start</string>
    <string>-p</string>
    <string>80</string>
    <string>-H</string>
    <string>127.0.0.1</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/danielko/dev/sites/apps/translate</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/danielko/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>TRANSLATE_UID</key>
    <string>501</string>
    <key>TRANSLATE_GID</key>
    <string>20</string>
    <key>TRANSLATE_HOME</key>
    <string>/Users/danielko</string>
    <key>TRANSLATE_USER</key>
    <string>danielko</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/translate.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/translate.log</string>
</dict>
</plist>
