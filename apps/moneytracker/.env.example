# ───────────────────────────────────────────────────────────────────────────
# moneytracker environment variables
# Copy to .env.local for local dev. In production, set these in the Vercel
# project dashboard (Settings → Environment Variables). NEVER commit real values.
# ───────────────────────────────────────────────────────────────────────────

# ── Auth (single user) ──────────────────────────────────────────────────────
# A long random string (>= 32 chars) used to encrypt/sign the session cookie.
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Your login password, stored as a SHA-256 hash (hex). The plaintext password
# never lives anywhere. Generate the hash for your chosen password:
#   node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
APP_PASSWORD_HASH=

# ── Token encryption ────────────────────────────────────────────────────────
# 32-byte key (hex = 64 chars) used to AES-256-GCM encrypt Plaid access tokens
# at rest. Generate: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Plaid ───────────────────────────────────────────────────────────────────
# From https://dashboard.plaid.com → Team Settings → Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (start with sandbox; switch to production once approved)
PLAID_ENV=sandbox
# Public base URL of this deployment, used for the Plaid webhook URL.
# e.g. https://moneytracker.vercel.app  (no trailing slash). Leave blank for local.
APP_BASE_URL=

# Plaid OAuth redirect URI — ONLY set this AFTER registering it in the Plaid
# Dashboard (API → Allowed redirect URIs). Required for OAuth banks like Chase
# in production; leave blank for sandbox / non-OAuth linking. Should be
# <APP_BASE_URL>/oauth, e.g. https://finance.dante4000.com/oauth
PLAID_REDIRECT_URI=

# ── Vercel Blob (datastore) ─────────────────────────────────────────────────
# Auto-injected by Vercel when you add a Blob store to the project. For local
# dev, copy the token from the Vercel dashboard (Storage → your Blob store).
BLOB_READ_WRITE_TOKEN=

# ── Cron security ───────────────────────────────────────────────────────────
# Random secret; Vercel Cron sends it as `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -hex 16
CRON_SECRET=
